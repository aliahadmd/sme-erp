# =============================================================================
# ERP dev environment — copy to .env and adjust if needed.
# Every service reads config ONLY from these variables, so swapping Postgres /
# Redis / S3 for external managed credentials later is a pure .env change.
# =============================================================================

# --- Postgres (pgvector/pgvector:pg17 in dev) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
# Hostname `postgres` resolves inside the docker network; change host for external DB.
DATABASE_URL=postgresql+asyncpg://erp:erp_dev_password@postgres:5432/erp

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3-compatible storage (SeaweedFS in dev; its s3.json is generated
#     from these values at container start — nothing is committed) ---
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=erp
S3_SECRET_KEY=erpdevsecret
S3_BUCKET=erp-dev
S3_REGION=us-east-1

# --- Auth ---
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-minimum
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Background jobs ---
# inline: jobs run in the API process (simplest dev setup)
# redis:  jobs are executed by the dedicated worker container
JOBS_MODE=inline

# --- AI / OpenRouter (optional in dev; leave empty to disable AI features) ---
OPENROUTER_API_KEY=
AI_DAILY_REQUEST_LIMIT=200
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Bootstrap admin (used by `make seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Admin

# --- Web ---
VITE_API_URL=http://localhost:8000
# Comma-separated list of allowed browser origins (no spaces needed):
# CORS_ORIGINS=http://localhost:5173,https://erp.example.com
